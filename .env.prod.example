NTEALAN_BASE_API_URL="https://apis.ntealan.net/ntealan/"
NTEALAN_API_KEY=your_api_key_here
NTEALAN_API_SECRET=your_api_secret_here
NTEALAN_API_VERSION=v1
NTEALAN_API_AIOHTTP_TIMEOUT=30
NTEALAN_API_AIOHTTP_RETRIES=3
NTEALAN_API_AIOHTTP_RETRY_DELAY=5
NTEALAN_API_LOG_LEVEL=info
NTEALAN_API_LOG_ENABLED=false

FASTMCP_SERVER_PORT=8000
FASTMCP_SERVER_DEBUG=false
FASTMCP_SERVER_MESSAGE_PATH=/messages/
FASTMCP_SERVER_SSE_PATH=/sse
FASTMCP_SERVER_HOST=https://apis.ntealan.net/ntealan/mcpserver
FASTMCP_SERVER_ON_DUPLICATE_RESOURCE=warn
FASTMCP_SERVER_ON_DUPLICATE_TOOLS=warn
FASTMCP_SERVER_ON_DUPLICATE_TOOLS=warn
FASTMCP_SERVER_ON_DUPLICATE_PROMPTS=warn
FASTMCP_SERVER_CACHE_EXPIRATION_SECONDS=3600

FASTMCP_TEST_MODE=false
FASTMCP_LOG_LEVEL=INFO

FASTMCP_CLIENT_LOG_LEVEL=INFO